# Optional: base URL of your deployed app (for remote sync). Leave empty to use current origin.
# Example: https://your-project.vercel.app
arVITE_API_URL=

# Required for Vercel API (api/state.js). Set in Vercel → Settings → Environment Variables.
# Use either tars_* (from Upstash dashboard) or UPSTASH_*:
#   tars_KV_REST_API_URL, tars_KV_REST_API_TOKEN
#   or UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
